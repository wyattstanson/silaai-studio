# ---- Database (Neon or Vercel Postgres) --------------------------------
# Pooled connection — used by the app/serverless functions at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct (unpooled) connection — used by `prisma migrate` and `db:seed`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ---- Optional ----------------------------------------------------------
# Lock CORS to your deployed origin (defaults to *).
# CORS_ORIGIN="https://your-app.vercel.app"

# ---- Frontend ----------------------------------------------------------
# Leave empty for same-origin /api on Vercel. Set only for a split deploy.
# VITE_API_URL="https://your-app.vercel.app"
